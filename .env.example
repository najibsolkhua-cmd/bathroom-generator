# Скопируйте этот файл в .env и заполните. Файл .env никому не показывайте.

# Ключ от посредника API (ProxyAPI и т.п.). Пока пусто — тестовый режим: примеры фото вместо генерации.
OPENAI_API_KEY=
# Адрес API посредника (для ProxyAPI — как ниже; для другого сервиса — из его документации)
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1

# Модель картинок. gpt-image-2.5-sunburst лучше всех сохраняет помещение с фото
# и тратит на картинку в 4 раза меньше токенов, чем gpt-image-2 (≈ 17 ₽ против ≈ 55 ₽ в high у ProxyAPI).
# Если посредник её не поддерживает, поставьте gpt-image-2.
IMAGE_MODEL=gpt-image-2.5-sunburst
# low / medium / high (у gpt-image-2.5 ещё xhigh и max). Для «как на Pinterest» — high.
IMAGE_QUALITY=high
# auto — по пропорциям фото клиента (вертикальное фото → вертикальные варианты)
IMAGE_SIZE=auto
# Сколько вариантов за одну генерацию (1–5). 3 вместо 5 — дешевле на 40%.
IMAGES_PER_JOB=5
# high — точнее сохранять геометрию фото клиента (если модель поддерживает параметр input_fidelity)
IMAGE_INPUT_FIDELITY=

# Проверка «только ванные»: самая недорогая модель с отметкой Vision из каталога посредника.
# У ProxyAPI это gpt-6-luna (30 ₽ / 150 ₽ за 1 млн токенов): все проверки одной генерации — меньше 2 ₽.
GUARD_MODEL=gpt-6-luna
# 0 — выключить проверку (не рекомендуется)
GUARD=1
# 1 — проверять каждую готовую картинку (что это ванная, без людей и надписей)
VERIFY_OUTPUT=1

# Водяной знак: файл PNG с прозрачным фоном. Нужен ImageMagick на сервере (sudo apt install imagemagick)
WATERMARK=1
WATERMARK_FILE=public/img/watermark.png

# Защита бюджета
DAILY_LIMIT_PER_IP=3
# 30 генераций × ≈ 300 ₽ в высоком качестве ≈ до 9 000 ₽ в день
GLOBAL_DAILY_LIMIT=30
MAX_PARALLEL=4

# Адрес сайта (нужен, чтобы в Telegram приходили ссылки на картинки и фото клиента)
PUBLIC_URL=https://ваш-домен.ru

# Заявки на замер в Telegram: токен бота от @BotFather и id чата
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Яндекс SmartCaptcha (желательно на боевом сайте)
SMARTCAPTCHA_CLIENT_KEY=
SMARTCAPTCHA_SERVER_KEY=

# Сервер
PORT=3000
HOST=127.0.0.1
# Сколько дней хранить картинки и фото клиентов
KEEP_DAYS=14
# Если сайт открыт с другого домена (например, GitHub Pages), перечислите его через запятую
CORS_ORIGINS=
# MOCK=1 — принудительно тестовый режим без трат
MOCK=
