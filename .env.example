# Скопируйте этот файл в .env и заполните. Файл .env никому не показывайте.

# Ключ от посредника API (ProxyAPI и т.п.). Пока пусто — сайт работает в тестовом режиме с эскизами.
OPENAI_API_KEY=
# Адрес API посредника (для ProxyAPI — как ниже; для другого сервиса — из его документации)
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1

# Модель и качество картинок
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=1536x1024
# low — дёшево и быстро, medium — оптимально, high — дорого и долго
IMAGE_QUALITY=medium
IMAGES_PER_JOB=5

# Защита бюджета
DAILY_LIMIT_PER_IP=3
GLOBAL_DAILY_LIMIT=200
MAX_PARALLEL=4

# Адрес сайта (нужен, чтобы в Telegram приходили ссылки на картинки)
PUBLIC_URL=https://ваш-домен.ru

# Заявки в Telegram: токен бота от @BotFather и id чата
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Яндекс SmartCaptcha (необязательно, но желательно на боевом сайте)
SMARTCAPTCHA_CLIENT_KEY=
SMARTCAPTCHA_SERVER_KEY=

# Сервер
PORT=3000
HOST=127.0.0.1
# Сколько дней хранить сгенерированные картинки
KEEP_DAYS=14
# Если сайт открыт с другого домена (например, GitHub Pages), перечислите его через запятую
CORS_ORIGINS=
# MOCK=1 — принудительно тестовый режим без трат
MOCK=
